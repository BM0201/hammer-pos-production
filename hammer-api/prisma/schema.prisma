model SaleOrder {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  branchId          String
  operationalDayId  String?
  customerId        String?
  createdByUserId   String
  status            SaleOrderStatus
  subtotal          Decimal         @default(0)
  discountTotal     Decimal         @default(0)
  taxTotal          Decimal         @default(0)
  grandTotal        Decimal         @default(0)
  requiresTransport Boolean         @default(false)
  transportAmount   Decimal         @default(0)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  /// Momento REAL de la anulación (sellado en cancelSaleOrder). El resumen del
  /// día filtra por esta columna; updatedAt solo queda como fallback legacy
  /// (una edición posterior re-contaba la anulación en el día de la edición).
  cancelledAt       DateTime?

  // ── Fecha operativa / offline (ERP source-of-truth) ──
  // saleOccurredAt: cuándo ocurrió realmente la venta (en POS, incluso offline).
  // postedAt: cuándo se asentó al día operativo. syncedAt: cuándo se sincronizó.
  saleOccurredAt  DateTime?
  postedAt        DateTime?
  syncedAt        DateTime?
  offlineClientId String?   @unique

  // ── Documentos comerciales ──
  documentMode          DocumentMode @default(DELIVERY_ORDER_ONLY)
  requiresManualInvoice Boolean      @default(false)

  // Orden de entrega
  deliveryOrderNumber    String?   @unique
  deliveryOrderIssuedAt  DateTime?
  deliveryOrderPrintedAt DateTime?

  // Factura manual
  manualInvoiceSeries         String?
  manualInvoiceNumber         String?
  manualInvoiceDate           DateTime?
  manualInvoiceCustomerName   String?
  manualInvoiceCustomerRuc    String?
  manualInvoiceStatus         ManualInvoiceStatus @default(NOT_REQUIRED)
  manualInvoiceRegisteredById String?
  manualInvoiceRegisteredAt   DateTime?
  manualInvoiceNotes          String?

  branch                      Branch             @relation(fields: [branchId], references: [id])
  operationalDay              OperationalDay?    @relation(fields: [operationalDayId], references: [id])
  customer                    Customer?          @relation(fields: [customerId], references: [id])
  createdBy                   User               @relation("SaleOrderCreatedBy", fields: [createdByUserId], references: [id])
  manualInvoiceRegisteredBy   User?              @relation("ManualInvoiceRegisteredBy", fields: [manualInvoiceRegisteredById], references: [id])
  lines                       SaleOrderLine[]
  payments                    Payment[]
  cancellations               SaleCancellation[] @relation("SaleCancellationOriginalOrder")
  replacementForCancellations SaleCancellation[] @relation("SaleCancellationReplacementOrder")
  returns                     SaleReturn[]
  creditNotes                 CreditNote[]
  dispatchTickets             DispatchTicket[]
  transportServices           TransportService[]
  documentPrintLogs           DocumentPrintLog[]

  @@unique([branchId, manualInvoiceSeries, manualInvoiceNumber])
  @@index([branchId, status])
  @@index([branchId, createdByUserId, status])
  @@index([customerId, createdAt])
  @@index([deliveryOrderNumber])
  @@index([manualInvoiceSeries, manualInvoiceNumber])
  @@index([operationalDayId])
  @@index([branchId, operationalDayId, status])
  // Dashboard de ventas y ventanas de dia operativo filtran por sucursal + rango de fechas
  @@index([branchId, createdAt])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. pgbouncer / Neon pooler) — used by the app
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma migrate` and introspection
  directUrl = env("DIRECT_URL")
}

enum RoleCode {
  SYSTEM_ADMIN
  OWNER
  MASTER
  BRANCH_ADMIN
  SALES
  CASHIER
  WAREHOUSE
  ACCOUNTANT
}

enum CashSessionStatus {
  OPEN
  RECONCILING
  CLOSED
  AUTO_CLOSED_PENDING_REVIEW
  AUTO_CLOSED
  PERMANENTLY_CLOSED
}

/// Día Operativo 360 — eje del SISTEMA (automático). ACTIVE = el día de su
/// fecha, acepta operaciones. AWAITING_REVIEW = pasó su fecha, dejó de
/// aceptar operaciones nuevas, espera revisión humana indefinidamente.
/// CANCELLED = anulación explícita de Master. Ningún proceso automático
/// mueve un día a CANCELLED ni lo saca de ahí.
enum OperationalDayLifecycle {
  ACTIVE
  AWAITING_REVIEW
  CANCELLED
}

/// Día Operativo 360 — eje de MASTER (manual), ortogonal a lifecycle. PENDING
/// es el default y no caduca: un día puede esperar confirmación indefinidamente
/// sin que ningún cron lo toque. CONFIRMED solo lo escribe un humano real.
enum OperationalDayReviewStatus {
  PENDING
  CONFIRMED
}

enum SaleOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  DISPATCH_PENDING
  DISPATCHED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  MIXED
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum PaymentWorkflowMode {
  QUEUE_ONLY
  DIRECT_ONLY
  HYBRID
}

enum DispatchWorkflowMode {
  DISABLED
  ENABLED
}

enum CashSessionOperatorRole {
  OWNER_OPERATOR
  CASHIER_OPERATOR
  SALES_DIRECT_OPERATOR
  SUPERVISOR_OPERATOR
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  CHANGE_IN
  BANK_DEPOSIT_OUT
  EXPENSE_OUT
  REFUND_OUT
  CORRECTION /// legado: corrección que SUMA a la gaveta (entrada)
  CORRECTION_OUT /// corrección que RESTA de la gaveta (salida)
}

enum DispatchStatus {
  PENDING
  IN_PROGRESS
  DISPATCHED
  CANCELLED
}

enum ApprovalType {
  RETURN
  PRICE_OVERRIDE
  CREDIT_EXCEPTION
  STOCK_ADJUSTMENT
  TRANSFER_EXCEPTION
  CASH_SESSION_DISCREPANCY /// DEPRECATED: ya no se crean nuevos registros de este tipo (ver cash-session/service.ts). Las discrepancias de caja ahora se manejan inline en el cierre de sesión, no vía cola de aprobaciones. Se mantiene solo por compatibilidad histórica con registros existentes.
  OPERATION_OVERRIDE
}

enum ApprovalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXECUTED
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  RETURN_OUT
  RETURN_IN_DAMAGED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  PACKAGE_IN
  PACKAGE_SALE_OUT
  PACKAGE_OPENED
  PACKAGE_AUTO_OPENED
  PACKAGE_CLOSED /// Fusión triple: reempaca sueltas de vuelta a empaque cerrado (reverso de PACKAGE_OPENED)
  LOOSE_UNIT_SALE_OUT
  LOOSE_UNIT_RETURN_IN
  LOOSE_ADJUSTMENT
  PACKAGE_ADJUSTMENT
  TIMBER_INTAKE_IN
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
  PRODUCTION_WASTE
  PRODUCTION_REVERSAL_IN /// Producción v2 Fase 4: devuelve al inventario un insumo consumido por un lote revertido
  PRODUCTION_REVERSAL_OUT /// Producción v2 Fase 4: retira el producto terminado agregado por un lote revertido
}

enum BrainDecisionStatus {
  OPEN
  APPROVED
  MANUAL_REVIEW
  EXECUTING
  EXECUTED
  DISMISSED
  SNOOZED
  EXPIRED
  FAILED
}

enum BrainDecisionCategory {
  INVENTORY
  REORDER
  PRICING
  CASH
  SALES
  DISPATCH
  PURCHASING
  PRODUCTION
  SECURITY
  AUDIT
  SYSTEM
}

enum BrainDecisionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum CreditScope {
  BRANCH_LOCAL
  UNIVERSAL
}

enum CurrencyCode {
  NIO
  USD
}

enum DocumentMode {
  DELIVERY_ORDER_ONLY
  MANUAL_INVOICE_REQUIRED
  MANUAL_INVOICE_REGISTERED
}

enum ManualInvoiceStatus {
  NOT_REQUIRED
  PENDING
  REGISTERED
  CANCELLED
}

enum SaleCancellationStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

enum SaleReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

enum SaleReturnType {
  PARTIAL
  TOTAL
}

enum ReturnedItemCondition {
  GOOD
  DAMAGED
  NOT_RETURNED
}

enum ReturnInventoryDestination {
  SELLABLE
  DAMAGED
  NONE
}

enum RefundMethod {
  CASH
  CARD
  TRANSFER
  CREDIT_NOTE
  MIXED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  APPROVED
  AVAILABLE
  PARTIALLY_USED
  USED
  VOIDED
  EXPIRED
}

enum CustomerRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum InventoryCondition {
  SELLABLE
  DAMAGED
}

enum PrinterMode {
  BROWSER_PRINT
  QZ_TRAY
  NETWORK_ESCPOS
  PDF_ONLY
}

enum PaperWidth {
  W58MM
  W80MM
  A4
}

enum DocumentType {
  DELIVERY_ORDER
  PURCHASE_TICKET
  PAYMENT_RECEIPT
  PRODUCTION_ORDER
}

model Branch {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  isActive          Boolean  @default(true)
  isDefaultSupplier Boolean  @default(false)
  /// Fondo de caja: lo que la sesión de caja de esta sucursal debería poder
  /// abrir al día siguiente. Sin configurar, todo lo retenido cuenta como
  /// esperando depósito — conservador y correcto (correccion-destino-y-pantalla-cobro.md §1.1).
  cashFundAmount    Decimal? @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userBranchRoles             UserBranchRole[]
  physicalCashBoxes           PhysicalCashBox[]
  customerScopes              CustomerBranchScope[]
  creditProfiles              CustomerCreditProfile[]
  inventoryBalances           InventoryBalance[]
  inventoryConditionBalances  InventoryConditionBalance[]
  inventoryMovements          InventoryMovement[]
  saleOrders                  SaleOrder[]
  saleCancellations           SaleCancellation[]
  saleReturns                 SaleReturn[]
  refunds                     Refund[]
  dispatchTickets             DispatchTicket[]              @relation("BranchDispatchTickets")
  approvalRequests            ApprovalRequest[]             @relation("BranchApprovalRequests")
  auditLogs                   AuditLog[]                    @relation("BranchAuditLogs")
  outgoingTransfers           Transfer[]                    @relation("TransferFromBranch")
  incomingTransfers           Transfer[]                    @relation("TransferToBranch")
  internalFreightOrigins      InternalFreightRoute[]        @relation("InternalFreightRouteOrigin")
  internalFreightDestinations InternalFreightRoute[]        @relation("InternalFreightRouteDestination")
  purchaseOrders              PurchaseOrder[]
  timberTrips                 TimberTrip[]
  operatingExpenses           OperatingExpense[]
  pricingConfig               PricingConfig?
  productPricings             ProductPricing[]
  categoryPricingPolicies     BranchCategoryPricingPolicy[]
  branchProductSettings       BranchProductSetting[]
  employees                   Employee[]
  employeeLoans               EmployeeLoan[]
  attendanceRollCalls         AttendanceRollCall[]
  payrollRuns                 PayrollRun[]
  payrollDisbursements        PayrollDisbursement[]
  discounts                   Discount[]
  branchRoleConfigs           BranchRoleConfig[]
  cashClosures                CashClosure[]
  transportServices           TransportService[]
  moduleConfig                BranchModuleConfig?
  reorderPolicies             StockReorderPolicy[]
  reorderAlerts               ReorderAlert[]                @relation("ReorderAlertBranch")
  reorderAlertSources         ReorderAlert[]                @relation("ReorderAlertSourceBranch")
  suggestionBatches           ReorderSuggestionBatch[]      @relation("SuggestionBatchBranch")
  suggestionBatchSources      ReorderSuggestionBatch[]      @relation("SuggestionBatchSourceBranch")
  productionBatches           ProductionBatch[]             @relation("ProductionBatches")
  printSettings               PrintSettings?
  brainDecisions              BrainDecision[]
  operationalDays             OperationalDay[]
  userPresences               UserPresence[]
  creditNotes                 CreditNote[]                  @relation("BranchCreditNotes")
  replenishmentDrafts         ReplenishmentDraft[]          @relation("BranchReplenishmentDrafts")
  replenishmentDraftItems     ReplenishmentDraftItem[]      @relation("ReplenishmentDraftItemBranch")
  replenishmentSignalSnapshot ReplenishmentSignalSnapshot?
  cameras                     Camera[]
  cameraAgent                 BranchCameraAgent?
  cameraHealthSnapshot        CameraHealthSnapshot?
  treasuryAccounts            TreasuryAccount[]
  bankDeposits                BankDeposit[]
  cashDestinationDeclarations CashDestinationDeclaration[]
  depositPolicy               BranchDepositPolicy?
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String    @unique
  passwordHash       String
  fullName           String
  globalRole         RoleCode?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  sessionVersion     Int       @default(0) /// Incremented on password/role changes to invalidate existing tokens
  /// MFA/TOTP — secreto cifrado en producción (AES-256-GCM con MFA_ENCRYPTION_KEY)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? /// Base32 TOTP secret (nullable = MFA not configured)
  mfaRecoveryCodes   Json? /// Array of SHA-256 hashed backup codes
  mfaEnabledAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userBranchRoles             UserBranchRole[]
  openedSessions              CashSession[]            @relation("CashSessionOpenedBy")
  closedSessions              CashSession[]            @relation("CashSessionClosedBy")
  reviewedCashSessions        CashSession[]            @relation("CashSessionReviewedBy")
  cashSessionOperators        CashSessionOperator[]    @relation("CashSessionOperatorUser")
  assignedCashOperators       CashSessionOperator[]    @relation("CashSessionOperatorAssignedBy")
  createdCashMovements        CashMovement[]           @relation("CashMovementCreatedBy")
  approvedCashMovements       CashMovement[]           @relation("CashMovementApprovedBy")
  confirmedBankDeposits       BankDeposit[]
  declaredCashDestinations    CashDestinationDeclaration[] @relation("CashDestinationDeclaredBy")
  handOverCashDestinations    CashDestinationDeclaration[] @relation("CashDestinationHandOverUser")
  carriedCashDeposits         CashDestinationDeclaration[] @relation("CashDestinationDepositCarrier")
  heldTreasuryAccounts        TreasuryAccount[]             @relation("TreasuryAccountHolder")
  createdTreasuryEntries      TreasuryEntry[]               @relation("TreasuryEntryCreatedBy")
  createdExchangeRates        ExchangeRate[]                @relation("ExchangeRateCreatedBy")
  openedOperationalDays       OperationalDay[]         @relation("OperationalDayOpenedBy")
  sweptOperationalDays        OperationalDay[]         @relation("OperationalDaySweptBy")
  reviewedOperationalDays     OperationalDay[]         @relation("OperationalDayReviewedBy")
  createdOrders               SaleOrder[]              @relation("SaleOrderCreatedBy")
  requestedSaleCancellations  SaleCancellation[]       @relation("SaleCancellationRequestedBy")
  approvedSaleCancellations   SaleCancellation[]       @relation("SaleCancellationApprovedBy")
  requestedSaleReturns        SaleReturn[]             @relation("SaleReturnRequestedBy")
  approvedSaleReturns         SaleReturn[]             @relation("SaleReturnApprovedBy")
  postedRefunds               Refund[]                 @relation("RefundPostedBy")
  approvedRefunds             Refund[]                 @relation("RefundApprovedBy")
  createdCreditNotes          CreditNote[]             @relation("CreditNoteCreatedBy")
  approvedCreditNotes         CreditNote[]             @relation("CreditNoteApprovedBy")
  payments                    Payment[]
  preparedDispatchTickets     DispatchTicket[]         @relation("DispatchPreparedBy")
  dispatchTickets             DispatchTicket[]         @relation("DispatchProcessedBy")
  requestedApprovals          ApprovalRequest[]        @relation("ApprovalRequestedBy")
  resolvedApprovals           ApprovalRequest[]        @relation("ApprovalResolvedBy")
  requestedTransfers          Transfer[]               @relation("TransferRequestedBy")
  approvedTransfers           Transfer[]               @relation("TransferApprovedBy")
  auditLogs                   AuditLog[]
  purchaseOrders              PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  createdDiscounts            Discount[]               @relation("DiscountCreatedBy")
  updatedBranchRoleConfigs    BranchRoleConfig[]       @relation("BranchRoleConfigUpdatedBy")
  updatedSystemSettings       SystemSetting[]          @relation("SystemSettingUpdatedBy")
  createdTransportServices    TransportService[]       @relation("TransportServiceCreatedBy")
  updatedBranchModuleConfigs  BranchModuleConfig[]     @relation("BranchModuleConfigUpdatedBy")
  updatedReorderPolicies      StockReorderPolicy[]     @relation("ReorderPolicyUpdatedBy")
  resolvedReorderAlerts       ReorderAlert[]           @relation("ReorderAlertResolvedBy")
  reviewedSuggestionBatches   ReorderSuggestionBatch[] @relation("SuggestionBatchReviewedBy")
  createdRecipes              ProductionRecipe[]       @relation("RecipeCreator")
  createdBatches              ProductionBatch[]        @relation("BatchCreator")
  userPermissions             UserPermission[]
  grantedPermissions          UserPermission[]         @relation("PermissionGrantedBy")
  registeredManualInvoices    SaleOrder[]              @relation("ManualInvoiceRegisteredBy")
  documentPrintLogs           DocumentPrintLog[]       @relation("DocumentPrintedBy")
  createdDocumentTemplates    DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  resolvedBrainDecisions      BrainDecision[]          @relation("BrainDecisionResolvedBy")
  brainDecisionActionLogs     BrainDecisionActionLog[] @relation("BrainDecisionActionActor")
  legacyBrainDecisions        BrainDecision[]          @relation("BrainDecisionLegacyUser")
  targetedBrainDecisions      BrainDecision[]          @relation("BrainDecisionTargetUser")
  presences                   UserPresence[]
  createdReplenishmentDrafts  ReplenishmentDraft[]     @relation("ReplenishmentDraftCreatedBy")
  approvedReplenishmentDrafts ReplenishmentDraft[]     @relation("ReplenishmentDraftApprovedBy")

  @@index([globalRole, isActive])
}

model UserPresence {
  id             String    @id @default(cuid())
  userId         String    @unique
  sessionId      String?
  branchId       String?
  username       String?
  roleCode       String?
  status         String    @default("ONLINE")
  currentPath    String?
  currentModule  String?
  lastSeenAt     DateTime  @default(now())
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([status])
  @@index([lastSeenAt])
}

model UserBranchRole {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  roleCode   RoleCode
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId, roleCode])
  @@index([userId, isActive])
  @@index([branchId, roleCode, isActive])
}

model PhysicalCashBox {
  id          String   @id @default(cuid())
  branchId    String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch        @relation(fields: [branchId], references: [id])
  sessions CashSession[]

  @@unique([branchId, code])
}

model CashSession {
  id                 String            @id @default(cuid())
  physicalCashBoxId  String
  operationalDayId   String?
  openedByUserId     String
  closedByUserId     String?
  reviewedByUserId   String?
  status             CashSessionStatus
  openedAt           DateTime
  closedAt           DateTime?
  autoClosedAt       DateTime?
  autoClosedReason   String?
  autoClosedBySystem Boolean           @default(false)
  openingAmount      Decimal
  closingAmount      Decimal?
  expectedCashAmount Decimal?
  countedCashAmount  Decimal?
  differenceAmount   Decimal?
  requiresReview     Boolean           @default(false)
  reviewedAt         DateTime?
  reviewNote         String?
  notes              String?
  activeSessionKey   String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  physicalCashBox PhysicalCashBox       @relation(fields: [physicalCashBoxId], references: [id])
  operationalDay  OperationalDay?       @relation(fields: [operationalDayId], references: [id])
  openedBy        User                  @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedBy        User?                 @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  reviewedBy      User?                 @relation("CashSessionReviewedBy", fields: [reviewedByUserId], references: [id])
  payments        Payment[]
  operators       CashSessionOperator[]
  cashMovements   CashMovement[]
  refunds         Refund[]
  destinationDeclaration CashDestinationDeclaration?

  @@index([physicalCashBoxId, status])
  @@index([operationalDayId])
  @@index([status, requiresReview])
}

model CashSessionOperator {
  id               String                  @id @default(cuid())
  cashSessionId    String
  userId           String
  operatorRole     CashSessionOperatorRole
  assignedByUserId String
  assignedAt       DateTime                @default(now())
  revokedAt        DateTime?
  isActive         Boolean                 @default(true)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user        User        @relation("CashSessionOperatorUser", fields: [userId], references: [id])
  assignedBy  User        @relation("CashSessionOperatorAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([cashSessionId, userId])
  @@index([cashSessionId, isActive])
  @@index([userId, isActive])
}

model CashMovement {
  id               String           @id @default(cuid())
  cashSessionId    String
  type             CashMovementType
  amount           Decimal
  reason           String
  notes            String?
  createdByUserId  String
  approvedByUserId String?
  createdAt        DateTime         @default(now())

  cashSession          CashSession           @relation(fields: [cashSessionId], references: [id])
  createdBy            User                  @relation("CashMovementCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy           User?                 @relation("CashMovementApprovedBy", fields: [approvedByUserId], references: [id])
  payrollDisbursements PayrollDisbursement[]
  operatingExpense     OperatingExpense?
  treasuryEntry        TreasuryEntry?

  @@index([cashSessionId, createdAt])
  @@index([type])
}

model OperationalDay {
  id           String   @id @default(cuid())
  branchId     String
  businessDate DateTime

  lifecycle    OperationalDayLifecycle    @default(ACTIVE)
  reviewStatus OperationalDayReviewStatus @default(PENDING)

  openedByUserId String
  openedAt       DateTime @default(now())

  /// Momento en que el día salió de ACTIVE. No implica revisión.
  sweptAt       DateTime?
  sweptBySystem Boolean   @default(false)
  sweptByUserId String?

  /// Firma humana. NUNCA la escribe un proceso automático.
  reviewedByUserId String?
  reviewedAt        DateTime?
  reviewNote         String?

  salesTotal                   Decimal  @default(0)
  paidOrdersTotal              Decimal  @default(0)
  pendingPaymentTotal          Decimal  @default(0)
  expectedCashTotal            Decimal?
  countedCashTotal             Decimal?
  cashDifferenceTotal          Decimal?
  openCashSessionsCount        Int      @default(0)
  autoClosedPendingReviewCount Int      @default(0)
  pendingDispatchCount         Int      @default(0)
  criticalBrainDecisionCount   Int      @default(0)
  notes                        String?
  checklistJson                Json?
  summaryJson                  Json?
  reviewSummaryJson            Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id])
  openedBy   User   @relation("OperationalDayOpenedBy", fields: [openedByUserId], references: [id])
  sweptBy    User?  @relation("OperationalDaySweptBy", fields: [sweptByUserId], references: [id])
  reviewedBy User?  @relation("OperationalDayReviewedBy", fields: [reviewedByUserId], references: [id])

  cashSessions      CashSession[]
  saleOrders        SaleOrder[]
  payments          Payment[]
  paymentTenders    PaymentTender[]
  dispatchTickets   DispatchTicket[]
  transportServices TransportService[]
  refunds           Refund[]
  saleCancellations SaleCancellation[]
  saleReturns       SaleReturn[]

  @@unique([branchId, businessDate])
  @@index([branchId, lifecycle])
  @@index([reviewStatus, businessDate])
  @@index([businessDate])
}

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique
  legalName   String
  displayName String
  taxId       String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchScopes   CustomerBranchScope[]
  creditProfiles CustomerCreditProfile[]
  creditScore    CustomerCreditScore?
  saleOrders     SaleOrder[]
  saleReturns    SaleReturn[]
  refunds        Refund[]
  creditNotes    CreditNote[]
}

model CustomerBranchScope {
  id         String   @id @default(cuid())
  customerId String
  branchId   String
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([customerId, branchId])
}

model CustomerCreditProfile {
  id               String      @id @default(cuid())
  customerId       String
  scope            CreditScope
  branchId         String?
  creditLimit      Decimal
  creditUsed       Decimal     @default(0)
  paymentTermsDays Int         @default(0)
  isActive         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([customerId, scope])
  @@index([branchId, isActive])
}

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent                  Category?                     @relation("CategoryToCategory", fields: [parentId], references: [id])
  children                Category[]                    @relation("CategoryToCategory")
  products                Product[]
  categoryPricingPolicies BranchCategoryPricingPolicy[]
  productStockGroups      ProductStockGroup[]
}

model BranchCategoryPricingPolicy {
  id                         String   @id @default(cuid())
  branchId                   String
  categoryId                 String
  minMarginPercent           Decimal  @default(15)
  targetMarginPercent        Decimal  @default(30)
  minProfitAmount            Decimal  @default(0)
  maxDiscountPercent         Decimal  @default(0)
  estimatedMonthlyUnits      Decimal  @default(1)
  estimatedMonthlySalesValue Decimal?
  monthlyExpenseAllocation   Decimal  @default(0)
  stockPolicy                String   @default("NORMAL")
  priceMode                  String   @default("CATEGORY")
  roundingRule               String   @default("NEAREST_1")
  isActive                   Boolean  @default(true)
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([branchId, categoryId])
  @@index([branchId, isActive])
  @@index([categoryId])
}

model Product {
  id                  String    @id @default(cuid())
  sku                 String    @unique
  barcode             String?   @unique
  name                String
  description         String?
  categoryId          String
  unit                String
  isActive            Boolean   @default(true)
  allowsFraction      Boolean   @default(false)
  isTimber            Boolean   @default(false)
  standardSalePrice   Decimal
  globalCost          Decimal?
  averageCost         Decimal?
  lastPurchaseCost    Decimal?
  costUpdatedAt       DateTime?
  costSource          String?
  costUpdatedByUserId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  /// ABC-XYZ Classification fields
  abcClassification    String? /// "A", "B", "C"
  xyzClassification    String? /// "X", "Y", "Z"
  rotationIndex        Decimal? /// IR = Cost of Sales / Average Inventory

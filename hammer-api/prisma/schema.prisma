/// Timber product dimensions and pre-calculated pricing.
/// Linked 1:1 with Product (isTimber=true).
/// Formulas from "FORMULA PARA MADERA.xlsx" — see src/modules/timber/calculator.ts
model TimberProduct {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  /// "TABLA" (width >= 10") or "CUADRO" (width < 10") or "TABLILLA" (1x6, 1x8)
  timberType String

  /// Dimensions: thickness & width in inches, length in feet
  thickness Decimal
  width     Decimal
  length    Decimal

  /// Calculated: (T × W × L) / 12
  boardFeet    Decimal
  /// Calculated: boardFeet × costPerFoot
  baseCost     Decimal
  /// Price per inch used for this product
  pricePerInch Decimal
  /// Calculated: T × W × varas × pricePerInch
  sellingPrice Decimal

  /// Vara length for this dimension (16→6, 15→5, 14→5, 11→4, 8→3)
  varaLength Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripLines TimberTripLine[]

  @@index([timberType])
}

/// Global timber pricing configuration (adjustable by MASTER)
model TimberPricingConfig {
  id                   String   @id @default(cuid())
  /// Cost per board foot (default C$20.00)
  costPerFoot          Decimal  @default(20)
  /// Price per inch for TABLA (width >= 10", default C$8.90)
  pricePerInchTabla    Decimal  @default(8.9)
  /// Price per inch for TABLILLA (1x6, 1x8, default C$6.90)
  pricePerInchTablilla Decimal  @default(6.9)
  /// Price per inch for CUADRO (rest, default C$6.90)
  pricePerInchCuadro   Decimal  @default(6.9)

  /// Madera v2 Fase 4 — configuración como datos (reemplaza constantes hardcodeadas).
  /// Array de { lengthFeet: number, varas: number, forceCuadro: boolean }. Semilla: VARA_LENGTH_MAP
  /// + LENGTHS_THAT_FORCE_CUADRO de calculator.ts.
  cubicationTable Json?
  /// Anchos (pulgadas) que clasifican como TABLA cuando el grosor es 1 o 2. Semilla: [10, 12].
  tablaWidths     Json?
  /// Anchos (pulgadas) que clasifican como TABLILLA cuando el grosor es 1. Semilla: [6, 8].
  tablillaWidths  Json?

  /// Margen objetivo (0-1) usado para la alerta de margen y la política TARGET_MARGIN. Default 40%.
  targetMarginPercent Decimal @default(0.40)
  /// Múltiplo (C$) al que se redondea HACIA ARRIBA el precio de la política TARGET_MARGIN —
  /// nunca hacia el más cercano, porque redondear al más cercano podría quedar bajo el margen
  /// objetivo. Default 1 (entero más próximo hacia arriba).
  targetMarginRoundingMultiple Decimal @default(1)
  /// Tolerancia de conciliación con factura (0-1). Default 1%.
  reconciliationTolerancePercent Decimal @default(0.01)
  /// Avisar (no bloquear) si un viaje deja margen bajo el objetivo.
  warnBelowTargetMargin Boolean @default(true)
  /// Bloquear la confirmación si hay margen negativo, salvo override explícito auditado.
  blockNegativeMargin   Boolean @default(true)

  /// Who last updated
  updatedBy            String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

/// A timber trip (viaje de madera) — wood arrives by trip, is cubicated, then enters inventory
enum TimberTripStatus {
  DRAFT
  CUBICADO
  CONFIRMED
  TRANSFERRED
  CANCELLED
}

model TimberTrip {
  id                  String @id @default(cuid())
  /// Human-readable trip code (e.g., "VJM-2026-001")
  tripCode            String @unique
  /// Destination branch where the wood arrives
  destinationBranchId String
  destinationBranch   Branch @relation(fields: [destinationBranchId], references: [id])

  status TimberTripStatus @default(DRAFT)

  /// Total cost of the trip (purchase price of all wood)
  woodTripTotalCost   Decimal @default(0)
  /// Computed: woodTripTotalCost / totalFeet — costo de la madera SOLA (sin gastos), se conserva para reporte
  computedCostPerFoot Decimal @default(0)

  /// Madera v2 Fase 1.1 — gastos del viaje (aditivo). Se prorratean por pie.
  freightAmount      Decimal @default(0)
  fuelAmount         Decimal @default(0)
  perDiemAmount      Decimal @default(0)
  permitsAmount      Decimal @default(0)
  otherExpensesAmount Decimal @default(0)
  /// Computed: suma de los 5 gastos de arriba
  tripExpensesTotal  Decimal @default(0)
  /// Computed: (maderaTotal + tripExpensesTotal) / totalFeet — el costo real que se usa
  /// para costear líneas, WAC de inventario y márgenes (reemplaza a computedCostPerFoot).
  landedCostPerFoot  Decimal @default(0)

  /// Madera v2 Fase 1.3 — conciliación con la factura del aserradero (opcional).
  invoicedFeet Decimal?

  /// Madera v2 Fase 2.3 — política de precio de venta al confirmar el viaje.
  /// RECALC_FROM_PRICE_PER_INCH (default) · COST_ONLY · TARGET_MARGIN
  pricePolicy String @default("RECALC_FROM_PRICE_PER_INCH")

  /// Pricing snapshot at time of calculation
  pricePerInchTabla    Decimal @default(8.9)
  pricePerInchTablilla Decimal @default(6.9)
  pricePerInchCuadro   Decimal @default(6.9)

  /// Totals (calculated)
  totalPieces   Int     @default(0)
  totalFeet     Decimal @default(0)
  totalCost     Decimal @default(0)
  totalSale     Decimal @default(0)
  totalProfit   Decimal @default(0)
  marginPercent Decimal @default(0)

  /// Supplier/origin info
  supplierName String?
  origin       String?
  notes        String?

  /// Who created/processed
  createdById   String?
  confirmedById String?
  confirmedAt   DateTime?
  /// Madera v2 Fase 3 — motivo cuando se confirma con margen negativo (override explícito).
  marginOverrideReason String?
  /// Madera v2 Fase 1.3 — confirmación explícita al confirmar fuera de tolerancia de conciliación.
  reconciliationAcknowledged Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines TimberTripLine[]

  @@index([status])
  @@index([destinationBranchId])
}

/// A line in a timber trip — represents a specific measure/dimension with piece count
model TimberTripLine {
  id     String     @id @default(cuid())
  tripId String
  trip   TimberTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Link to the timber product (measure) — optional until confirmed
  timberProductId String?
  timberProduct   TimberProduct? @relation(fields: [timberProductId], references: [id])

  /// Dimension snapshot
  thicknessIn Int
  widthIn     Int
  lengthIn    Int
  varaLength  Int
  priceGroup  String /// TABLA, TABLILLA, CUADRO

  /// Quantities
  pieces Int @default(0)

  /// Calculated values
  calculatedFeet              Decimal @default(0)
  calculatedCostFeet          Decimal @default(0)
  calculatedCostPerPiece      Decimal @default(0)
  calculatedSalePricePerPiece Decimal @default(0)
  calculatedSaleTotal         Decimal @default(0)
  calculatedProfit            Decimal @default(0)
  calculatedMarginPct         Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}


{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["cle1"],
  "crons": [
    {
      "path": "/api/system/cron/operational-automation",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/system/cron/brain-scan",
      "schedule": "35 0-3,12-23 * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
